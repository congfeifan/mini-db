{
  "feature": "arithmetic",
  "version": 1,
  "payload_fields": ["statement"],
  "precedence": ["unary + -", "* /", "+ -", "comparison", "NOT", "AND", "OR"],
  "valid_examples": [
    {"sql": "SELECT * FROM t WHERE age>10+2*4;", "expected_shape": ">(age,+(10,*(2,4)))"},
